generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String?   @map("password_hash")
  fullName     String    @map("full_name") @db.VarChar(255)
  phone        String?   @db.VarChar(50)
  globalRole   String?   @default("owner") @map("global_role") @db.VarChar(50)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([email], map: "idx_users_email")
  @@map("users")
}

model Hostel {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId              String?         @map("owner_id") @db.Uuid
  name                 String          @db.VarChar(255)
  code                 String          @unique @db.VarChar(50)
  type                 String          @default("Boys") @db.VarChar(50)
  address              String          @default("")
  city                 String          @default("Hyderabad") @db.VarChar(100)
  state                String          @default("Telangana") @db.VarChar(100)
  pincode              String          @default("") @db.VarChar(20)
  contactPhone         String          @default("") @map("contact_phone") @db.VarChar(50)
  contactEmail         String          @default("") @map("contact_email") @db.VarChar(255)
  monthlyTargetRevenue Decimal?        @default(0) @map("monthly_target_revenue") @db.Decimal(12, 2)
  createdAt            DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  expenses             Expense[]
  staff                HostelStaff[]
  notifications        notifications[]
  payments             Payment[]
  rooms                Room[]
  tenants              Tenant[]

  @@index([code], map: "idx_hostels_code")
  @@index([ownerId], map: "idx_hostels_owner_id")
  @@map("hostels")
}

model HostelStaff {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostelId    String    @map("hostel_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  branchRole  String    @map("branch_role") @db.VarChar(50)
  permissions Json?     @default("[]")
  assignedAt  DateTime? @default(now()) @map("assigned_at") @db.Timestamptz(6)
  hostel      Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([hostelId, userId])
  @@index([hostelId], map: "idx_hostel_staff_hostel")
  @@index([userId], map: "idx_hostel_staff_user")
  @@map("hostel_staff")
}

model Room {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostelId  String    @map("hostel_id") @db.Uuid
  number    String    @map("room_number") @db.VarChar(50)
  type      String    @default("Double") @db.VarChar(50)
  capacity  Int       @default(1)
  occupied  Int       @default(0)
  rent      Decimal   @default(0) @db.Decimal(10, 2)
  floor     Int       @default(1)
  status    String    @default("available") @db.VarChar(50)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  hostel    Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants   Tenant[]

  @@unique([hostelId, number])
  @@index([hostelId, floor], map: "idx_rooms_floor")
  @@index([hostelId], map: "idx_rooms_hostel_id")
  @@map("rooms")
}

model Tenant {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostelId             String          @map("hostel_id") @db.Uuid
  roomId               String?         @map("room_id") @db.Uuid
  roomNumber           String          @map("room_number") @db.VarChar(50)
  name                 String          @db.VarChar(255)
  phone                String          @db.VarChar(50)
  email                String          @db.VarChar(255)
  checkIn              DateTime        @default(dbgenerated("CURRENT_DATE")) @map("check_in") @db.Date
  rentDue              DateTime        @map("rent_due") @db.Date
  rentAmount           Decimal         @default(0) @map("rent_amount") @db.Decimal(10, 2)
  cycleStartDate       DateTime?       @map("cycle_start_date") @db.Date
  cycleEndDate         DateTime?       @map("cycle_end_date") @db.Date
  remindersSent        Int             @default(0) @map("reminders_sent")
  advanceAmount        Decimal         @default(0) @map("advance_amount") @db.Decimal(10, 2)
  advancePaid          Boolean         @default(false) @map("advance_paid")
  advanceReturned      Boolean         @default(false) @map("advance_returned")
  advanceReturnDate    DateTime?       @map("advance_return_date") @db.Date
  advanceRefundAmount  Decimal?        @map("advance_refund_amount") @db.Decimal(10, 2)
  advanceNotes         String?         @map("advance_notes")
  maintenanceDeduction Decimal         @default(0) @map("maintenance_deduction") @db.Decimal(10, 2)
  negligencePenalty    Decimal         @default(0) @map("negligence_penalty") @db.Decimal(10, 2)
  noticeStatus         String?         @map("notice_status") @db.VarChar(50)
  status               String          @default("active") @db.VarChar(50)
  paid                 Boolean         @default(false)
  avatar               String?
  createdAt            DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  notifications        notifications[]
  payments             Payment[]
  hostel               Hostel          @relation(fields: [hostelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  room                 Room?           @relation(fields: [roomId], references: [id], onUpdate: NoAction)

  @@index([hostelId], map: "idx_tenants_hostel_id")
  @@index([roomId], map: "idx_tenants_room_id")
  @@index([status], map: "idx_tenants_status")
  @@map("tenants")
}

model Payment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostelId   String    @map("hostel_id") @db.Uuid
  tenantId   String?   @map("tenant_id") @db.Uuid
  tenantName String    @map("tenant_name") @db.VarChar(255)
  roomNumber String    @map("room_number") @db.VarChar(50)
  amount     Decimal   @db.Decimal(10, 2)
  method     String    @default("UPI") @db.VarChar(50)
  type       String    @default("Rent") @db.VarChar(50)
  notes      String?
  date       DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  hostel     Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onUpdate: NoAction)

  @@index([date], map: "idx_payments_date")
  @@index([hostelId], map: "idx_payments_hostel_id")
  @@map("payments")
}

model Expense {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostelId  String    @map("hostel_id") @db.Uuid
  date      DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  category  String    @db.VarChar(50)
  amount    Decimal   @db.Decimal(10, 2)
  note      String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  hostel    Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([category], map: "idx_expenses_category")
  @@index([hostelId], map: "idx_expenses_hostel_id")
  @@map("expenses")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_id  String    @db.Uuid
  tenant_id  String?   @db.Uuid
  type       String    @default("rent_reminder") @db.VarChar(50)
  title      String    @db.VarChar(255)
  message    String
  status     String    @default("sent") @db.VarChar(50)
  sent_at    DateTime? @default(now()) @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  hostels    Hostel    @relation(fields: [hostel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants    Tenant?   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([hostel_id], map: "idx_notifications_hostel")
}
